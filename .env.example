# CampusFlow AI — environment variables.
# Copy to .env (git-ignored) and fill in. Never commit .env.
# Telegram, Gemini and other API secrets do NOT go here: they live in n8n credentials.

# Encrypts the credentials n8n stores. Generate ONCE (see README) and never change it:
# with a different key, every saved credential becomes unreadable. Keep a copy in a password manager.
N8N_ENCRYPTION_KEY=

# Public base URL n8n uses for webhooks. localhost until the ngrok tunnel exists (CF-007),
# then https://<your-domain>.ngrok-free.app/
WEBHOOK_URL=http://localhost:5678/

# ngrok tunnel (service "ngrok" in docker-compose.yml). Free account: dashboard → "Your Authtoken" and
# Domains → your free dev domain. The authtoken is a secret: it stays in .env only.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-domain.ngrok-free.dev
