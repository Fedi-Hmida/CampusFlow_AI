      {
        "parameters": {
          "jsCode": "// Normalise the Telegram message; convert an attached photo to base64 for Gemini\nconst item = $input.first();\nconst m = item.json.message || {};\nconst hasPhoto = Array.isArray(m.photo) && m.photo.length > 0;\nlet photoB64 = '';\nlet photoMime = 'image/jpeg';\nif (hasPhoto && item.binary) {\n  const key = Object.keys(item.binary)[0];\n  const buf = await this.helpers.getBinaryDataBuffer(0, key);\n  photoB64 = buf.toString('base64');\n  photoMime = item.binary[key].mimeType || photoMime;\n}\nreturn [{ json: { chatId: m.chat?.id, text: m.text || m.caption || 'Bonjour', hasPhoto: hasPhoto && photoB64 !== '', photoB64, photoMime } }];"
        },
        "id": "7d1c2a10-0001-4c00-9000-000000000002",
        "name": "Input",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
