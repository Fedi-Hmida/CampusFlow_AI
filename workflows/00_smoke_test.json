          "jsonBody": "={{ JSON.stringify({ model: 'qwen3:4b-instruct-2507-q4_K_M', stream: false, options: { num_predict: 80 }, messages: [{ role: 'user', content: 'Réponds en une seule phrase en français : ' + $('Input').first().json.text }] }) }}",
          "options": {
